generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum ListingType {
  RENT
  SALE
}

enum PropertyType {
  APARTMENT
  VILLA
  INDEPENDENT_HOUSE
  PLOT
  COMMERCIAL
  PG
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
  SOLD
  RENTED
}

// ── NEW ──────────────────────────────────────────────────────
enum InquiryStatus {
  PENDING    // sent, owner not yet responded
  READ       // owner has seen it
  RESPONDED  // owner replied
  CLOSED     // conversation closed
  SPAM       // flagged as spam
}
// ─────────────────────────────────────────────────────────────

model User {
  id String @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  phone        String?
  role         UserRole @default(USER)
  isVerified   Boolean  @default(false) @map("is_verified")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt      @map("updated_at")

  refreshTokens  RefreshToken[]
  properties     Property[]
  inquiriesSent  Inquiry[] @relation("InquirySender")
  inquiriesOwned Inquiry[] @relation("InquiryReceiver")

  @@map("users")
}

model RefreshToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid @map("user_id")
  tokenHash String   @unique @map("token_hash")
  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  family    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Property {
  id        String @id @default(uuid()) @db.Uuid
  ownerId   String @db.Uuid @map("owner_id")
  title        String
  description  String
  listingType  ListingType    @map("listing_type")
  propertyType PropertyType   @map("property_type")
  status       PropertyStatus @default(ACTIVE)
  price        Decimal        @db.Decimal(12, 2)
  city         String
  locality     String
  state        String
  pincode      String
  latitude     Decimal?       @db.Decimal(10, 7)
  longitude    Decimal?       @db.Decimal(10, 7)
  bedrooms     Int
  bathrooms    Int
  areaSqft     Decimal        @map("area_sqft") @db.Decimal(10, 2)
  isFurnished  Boolean        @default(false) @map("is_furnished")
  isActive     Boolean        @default(true)  @map("is_active")
  viewCount    Int            @default(0)     @map("view_count")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt      @map("updated_at")

  owner     User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  images    PropertyImage[]
  inquiries Inquiry[]

  @@index([ownerId],                                name: "idx_properties_owner_id")
  @@index([city],                                   name: "idx_properties_city")
  @@index([locality],                               name: "idx_properties_locality")
  @@index([price],                                  name: "idx_properties_price")
  @@index([createdAt],                              name: "idx_properties_created_at")
  @@index([bedrooms],                               name: "idx_properties_bedrooms")
  @@index([isActive, createdAt(sort: Desc)],        name: "idx_properties_feed")
  @@index([city, propertyType, listingType, isActive], name: "idx_properties_search")
  @@index([isActive, price, listingType],           name: "idx_properties_price_range")
  @@index([city, bedrooms, isActive],               name: "idx_properties_bedrooms_city")
  @@index([ownerId, isActive, createdAt(sort: Desc)], name: "idx_properties_owner_active")
  @@map("properties")
}

model PropertyImage {
  id         String @id @default(uuid()) @db.Uuid
  propertyId String @db.Uuid @map("property_id")  
  url          String
  key          String
  isPrimary    Boolean  @default(false) @map("is_primary")
  displayOrder Int      @default(0)     @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId],            name: "idx_property_images_property_id")
  @@index([propertyId, isPrimary], name: "idx_property_images_primary")
  @@map("property_images")
}

model Inquiry {
  id         String @id @default(uuid()) @db.Uuid
  propertyId String @db.Uuid @map("property_id")
  senderId   String @db.Uuid @map("sender_id")
  receiverId String @db.Uuid @map("receiver_id")
  message      String        @db.Text
  status       InquiryStatus @default(PENDING)
  // Tracks when the sender last submitted to this property.
  // Used for the 24-hour cooldown window duplicate check.
  lastSentAt   DateTime      @default(now()) @map("last_sent_at")
  spamScore    Int           @default(0)     @map("spam_score")
  ipAddress    String?       @map("ip_address")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt      @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  sender   User     @relation("InquirySender",  fields: [senderId],   references: [id], onDelete: Cascade)
  receiver User     @relation("InquiryReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  // ── Indexes ─────────────────────────────────────────────────
  // Property inbox — all inquiries for a listing (owner view)
  @@index([propertyId, createdAt(sort: Desc)], name: "idx_inquiries_property_inbox")
  // Sent box — all inquiries by a user (sender view)
  @@index([senderId, createdAt(sort: Desc)],   name: "idx_inquiries_sent_box")
  // Owner inbox — all inquiries a user received as property owner
  @@index([receiverId, status, createdAt(sort: Desc)], name: "idx_inquiries_owner_inbox")
  // Duplicate check — sender + property combo lookup
  @@index([senderId, propertyId, lastSentAt],  name: "idx_inquiries_duplicate_check")

  // ── Unique constraint — ONE active inquiry per sender+property ─
  // This is the DB-level duplicate guard. Even if two requests
  // arrive simultaneously (race condition), only one succeeds.
  // The app-level check is the UX guard; this is the real guard.
  @@unique([senderId, propertyId], name: "uq_inquiry_sender_property")

  @@map("inquiries")
}
